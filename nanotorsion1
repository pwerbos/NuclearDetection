import numpy as np

# --- 1. CONSTANTS & v11 GEOMETRIC PARAMETERS ---
EPSILON_GEO = np.pi / 18.0          # SL(2,C) toroidal volume-form invariant (~0.174533)
HBAR_EV_S = 6.5821195e-16           # Reduced Planck constant (eV * s)
M_0_EV = 0.51099895e6 / (3.0e8)**2  # Electron rest mass energy equivalent (eV * s^2 / m^2)
EFFECTIVE_MASS_RATIO = 0.067        # Gallium Arsenide (GaAs) conduction band effective mass ratio
M_STAR = EFFECTIVE_MASS_RATIO * M_0_EV

def calculate_superlattice_transmission(energy_ev_array, barrier_height_ev=0.3, barrier_width_nm=2.0, well_width_nm=5.0, num_periods=5):
    """
    Computes transmission probability T(E) across a multi-quantum-well superlattice
    incorporating the non-linear v11 torsion vacuum perturbation potential.
    """
    print("==================================================================")
    print("   OUROBOROS v11 NANO-TORSION TRANSPORT SIMULATION                ")
    print("==================================================================")
    print(f"[*] Geometric Invariant (eps = pi/18) : {EPSILON_GEO:.6f}")
    print(f"[*] Superlattice Periods            : {num_periods}")
    print(f"[*] Barrier Width / Well Width      : {barrier_width_nm} nm / {well_width_nm} nm")
    print("-" * 66)

    # Convert widths to meters
    b_width = barrier_width_nm * 1e-9
    w_width = well_width_nm * 1e-9
    
    transmission_results = []

    for e in energy_ev_array:
        if e <= 0:
            transmission_results.append(0.0)
            continue
            
        # Wavevector in well (k1) and barrier (k2)
        # Incorporating v11 non-linear vacuum torsion perturbation (proportional to eps^2)
        torsion_perturbation = (EPSILON_GEO**2) * (e / barrier_height_ev)
        effective_barrier = max(0.001, barrier_height_ev - torsion_perturbation)
        
        k_well = np.sqrt(2.0 * M_STAR * e) / HBAR_EV_S
        if e < effective_barrier:
            kappa_barrier = np.sqrt(2.0 * M_STAR * (effective_barrier - e)) / HBAR_EV_S
            # Transfer matrix approximation for attenuation factor across barriers
            decay = kappa_barrier * b_width
            # Transmission coefficient modulated by multi-well resonance and torsion coupling
            t_coeff = 1.0 / (1.0 + 0.25 * ((effective_barrier / (e * (effective_barrier - e)))**2) * np.sinh(num_periods * decay)**2)
        else:
            k_barrier = np.sqrt(2.0 * M_STAR * (e - effective_barrier)) / HBAR_EV_S
            t_coeff = 1.0 / (1.0 + 0.25 * ((effective_barrier / (e * (e - effective_barrier)))**2) * np.sin(num_periods * k_barrier * b_width)**2)
            
        transmission_results.append(float(t_coeff))
        
    return np.array(transmission_results)

